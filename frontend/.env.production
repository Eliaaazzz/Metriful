# Production environment - deployed backend
# NOTE: These are the same Google OAuth Client IDs as development
# They are registered in Google Cloud Console for your app

# API Configuration - CloudFront handles routing /api/* to backend
EXPO_PUBLIC_API_BASE_URL=https://aurafitness.org
API_BASE_URL=https://aurafitness.org
EXPO_PUBLIC_API_KEY=fitness-secret-key-123
API_KEY=fitness-secret-key-123

# Google OAuth Client IDs (Required for Google Sign-In)
# These are loaded from environment variables - NOT hardcoded
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=113023901864-63dojacud95051e1grii61s93l1bjqf2.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=113023901864-0nla6f5g1kpnf1qhc6euas47n5oi63nb.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=113023901864-n9pe3iu6v0s0f3gq2u0mu6d9rfqbke8l.apps.googleusercontent.com

# Apple Sign-In (Required for web Apple Sign-In)
EXPO_PUBLIC_APPLE_SERVICE_ID=org.aurafitness.web

# Google Analytics 4 (web only). Create a GA4 property + web data stream at
# analytics.google.com, then paste its Measurement ID (format: G-XXXXXXXXXX).
# Empty = analytics fully disabled (no snippet injected, runtime no-ops).
EXPO_PUBLIC_GA_MEASUREMENT_ID=
