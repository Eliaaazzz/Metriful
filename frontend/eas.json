{
  "cli": {
    "version": ">= 16.13.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "extends": "production",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "production",
      "distribution": "internal"
    },
    "health-preview": {
      "extends": "preview",
      "autoIncrement": true,
      "ios": { "buildConfiguration": "Release" }
    },
    "health-simulator": {
      "extends": "health-preview",
      "ios": { "simulator": true }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://aurafitness.org",
        "API_BASE_URL": "https://aurafitness.org",
        "EXPO_PUBLIC_API_KEY": "fitness-secret-key-123",
        "API_KEY": "fitness-secret-key-123",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "113023901864-63dojacud95051e1grii61s93l1bjqf2.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "113023901864-n9pe3iu6v0s0f3gq2u0mu6d9rfqbke8l.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "113023901864-0nla6f5g1kpnf1qhc6euas47n5oi63nb.apps.googleusercontent.com",
        "EXPO_PUBLIC_APPLE_SERVICE_ID": "org.aurafitness.web"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
