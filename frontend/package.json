{
  "name": "fitness-mvp-frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:check": "node scripts/verify-health-ios.cjs",
    "ios:build:health": "npx eas-cli@25.3.0 build --platform ios --profile health-preview",
    "ios:build:health-simulator": "npx eas-cli@25.3.0 build --platform ios --profile health-simulator",
    "web": "expo start --web",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Linting not configured yet' && exit 0",
    "build": "npx expo export --platform web && npm run postbuild",
    "postbuild": "node scripts/prerender-landing.mjs dist/index.html"
  },
