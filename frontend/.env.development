# Development environment - Local backend
# Use localhost for web development (cookies require same host)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
# Use LAN IP for mobile device/simulator access (uncomment below, comment above)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.2:8080
# API_BASE_URL=http://192.168.0.2:8080
EXPO_PUBLIC_API_KEY=fitness-secret-key-123
API_KEY=fitness-secret-key-123
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=113023901864-63dojacud95051e1grii61s93l1bjqf2.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=113023901864-0nla6f5g1kpnf1qhc6euas47n5oi63nb.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=113023901864-n9pe3iu6v0s0f3gq2u0mu6d9rfqbke8l.apps.googleusercontent.com

# Apple Sign-In (Required for web Apple Sign-In)
EXPO_PUBLIC_APPLE_SERVICE_ID=

# Google Analytics 4 (web only). Paste a GA4 web-stream Measurement ID
# (format: G-XXXXXXXXXX) to enable tracking; leave empty to keep analytics
# off — recommended for local development so dev traffic never pollutes data.
EXPO_PUBLIC_GA_MEASUREMENT_ID=
